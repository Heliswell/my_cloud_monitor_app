# --- SECRETS & CONFIG ---
# Never upload your Slack Webhook URL or API keys
.env

# --- DATABASES & LOCAL DATA ---
# These are generated by your app; you don't want to track your local history
metrics.db
backend_data.json
*.csv

# --- PYTHON JUNK ---
# Temporary files created when Python runs
__pycache__/
*.py[cod]
*$py.class
venv/
env/

# --- OPERATING SYSTEM JUNK ---
.DS_Store
Thumbs.db